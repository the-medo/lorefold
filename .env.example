# Optional, development-only settings. setup copies this file to .env only if absent.
# These are contracts for the future app; provider implementations do not exist yet.
# The worktree launcher supplies DATABASE_URL, ports, origins, and auth secrets.
# Never put secrets in VITE_* variables: they are exposed to the browser.

# Future local development defaults: local files and deterministic AI fixtures.
# Production uses private Cloudflare R2 and Cloudflare AI Gateway.
LOREFOLD_STORAGE_MODE=local
LOREFOLD_AI_MODE=mock

# Opt in to external development services only with development credentials.
# Use a development R2 bucket, never the production bucket. The launcher assigns
# a unique R2_KEY_PREFIX to each worktree.
CLOUDFLARE_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_AI_GATEWAY_ID=
AI_MODEL=

# Populate only when the app's social-login providers are implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
