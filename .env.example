# Optional, development-only settings. setup copies this file to .env only if absent.
# Imports default to local private files and deterministic mock analysis.
# The worktree launcher supplies DATABASE_URL, ports, origins, and auth secrets.
# Never put secrets in VITE_* variables: they are exposed to the browser.
# New .env files inherit Google development credentials from this machine's
# Lorefold profile when configured. Existing .env files are never overwritten.
# Save a configured pair with: lorefold-worktree-dev configure-google --from-env .env

# When forwarding to a different port on your computer, set its exact browser URL.
# Development-only; trusts this origin for sign-in and progress updates.
# Example: LOREFOLD_DEV_BROWSER_ORIGIN=http://localhost:60204
LOREFOLD_DEV_BROWSER_ORIGIN=

# Storage: local (development only) or r2. Analysis: mock, chatgpt-plan, or gateway.
# Production uses private Cloudflare R2 and Cloudflare AI Gateway.
LOREFOLD_STORAGE_MODE=local
LOREFOLD_AI_MODE=mock
# Explicit live-import opt-in. Does not enable benchmark CLI calls.
LOREFOLD_IMPORT_LIVE=0
# Development R2 access also needs explicit opt-in and a private development bucket.
LOREFOLD_R2_LIVE=0

# Opt in to external development services only with development credentials.
# Use a development R2 bucket, never the production bucket. The launcher assigns
# a unique R2_KEY_PREFIX to each worktree.
CLOUDFLARE_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_API_TOKEN=

# Optional Google sign-in for existing invited users. Set both or leave both empty.
# Register <Browser URL>/api/auth/callback/google as a Web OAuth redirect URI.
# See docs/google-sign-in.md. Credentials stay server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Future provider; not implemented.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Personal connection: development OAuth or owner-only production VM transfer.
# Use LOREFOLD_AI_MODE=chatgpt-plan and LOREFOLD_IMPORT_LIVE=1 for real imports.
LOREFOLD_CHATGPT_PERSONAL=0
LOREFOLD_CHATGPT_CALLBACK_PORT=15190
# For a browser on another computer: user@private-host (SSH access required).
LOREFOLD_CHATGPT_SSH_TARGET=
# Website connections can use encrypted PostgreSQL storage across web/worker.
# File remains the default; CLI benchmark credentials always stay separate.
LOREFOLD_CHATGPT_STORAGE=file
# For database mode: a dedicated 32-byte key encoded as 64 hex characters.
# Keep the same runtime-only key on web and worker, backed up outside the DB.
LOREFOLD_CHATGPT_ENCRYPTION_KEY=
# Optional single-owner restriction (also blocks existing other-user sessions).
# Required with PERSONAL=1 in production; use your Lorefold sign-in email.
LOREFOLD_OWNER_EMAIL=
