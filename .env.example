# Optional, development-only settings. setup copies this file to .env only if absent.
# R2/AI providers remain future contracts; development uploads use local files.
# The worktree launcher supplies DATABASE_URL, ports, origins, and auth secrets.
# Never put secrets in VITE_* variables: they are exposed to the browser.
# New .env files inherit Google development credentials from this machine's
# Lorefold profile when configured. Existing .env files are never overwritten.
# Save a configured pair with: lorefold-worktree-dev configure-google --from-env .env

# When forwarding to a different port on your computer, set its exact browser URL.
# Development-only; trusts this origin for sign-in and progress updates.
# Example: LOREFOLD_DEV_BROWSER_ORIGIN=http://localhost:60204
LOREFOLD_DEV_BROWSER_ORIGIN=

# Local originals are saved privately. Mock AI remains a future provider contract.
# Production uses private Cloudflare R2 and Cloudflare AI Gateway.
LOREFOLD_STORAGE_MODE=local
LOREFOLD_AI_MODE=mock

# Opt in to external development services only with development credentials.
# Use a development R2 bucket, never the production bucket. The launcher assigns
# a unique R2_KEY_PREFIX to each worktree.
CLOUDFLARE_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_AI_GATEWAY_ID=
AI_MODEL=

# Optional Google sign-in for existing invited users. Set both or leave both empty.
# Register <Browser URL>/api/auth/callback/google as a Web OAuth redirect URI.
# See docs/google-sign-in.md. Credentials stay server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Future provider; not implemented.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
